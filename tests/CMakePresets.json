{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "tests",
      "displayName": "Tests",
      "description": "Build stack-test and runtime-test (Catch2 required)",
      "binaryDir": "${sourceDir}/../build-tests"
    }
  ],
  "buildPresets": [
    { "name": "tests", "configurePreset": "tests" }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": { "verbosity": "verbose" }
    }
  ]
}
